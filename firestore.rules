rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Progreso completo de cada jugador: solo lo lee y escribe su dueño.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Clasificación mundial: cualquiera la puede ver;
    // cada jugador solo puede escribir su propia fila, con datos limitados.
    match /leaderboard/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'total', 'medals', 'updated'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 16
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.total < 10000000
        && request.resource.data.medals is int
        && request.resource.data.updated is int;
    }
  }
}
